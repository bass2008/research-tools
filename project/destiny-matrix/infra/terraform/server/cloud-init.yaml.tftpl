#cloud-config
# Машина умеет ровно одно: тянуть образы из реестра и держать их поднятыми за nginx.
# Ни node, ни python, ни postgres на хосте нет — всё внутри контейнеров.
package_update: true
packages:
  - nginx
  - python3-certbot-nginx
  - docker.io
  - docker-compose-v2
  - jq
  - curl

write_files:
  - path: /etc/nginx/conf.d/arcana-tuning.conf
    permissions: '0644'
    content: |
      server_tokens off;
      client_max_body_size 2m;
      # gzip on уже включён в штатном nginx.conf Ubuntu: повтор — «duplicate directive» и nginx не стартует
      gzip_vary on;
      gzip_proxied any;
      gzip_min_length 1024;
      gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

  # Здесь лежит только минимум, чтобы машина ответила на 80 порт и certbot смог выписать
  # сертификат. Рабочие конфиги — прод, тестовый домен, фильтры сканеров — живут в репозитории
  # (infra/nginx) и приезжают скриптом infra/deploy-nginx.sh. Держать их в двух местах нельзя:
  # копии расходятся, а правки руками на машине теряются при пересоздании.
  - path: /etc/nginx/sites-available/arcana.conf
    permissions: '0644'
    content: |
      server {
          listen 80 default_server;
          listen [::]:80 default_server;
          server_name ${site_fqdn} www.${site_fqdn} _;

          location /_next/static/ {
              alias ${app_dir}/static/;
              access_log off;
              add_header Cache-Control "public, max-age=31536000, immutable" always;
          }

          location / {
              proxy_pass http://127.0.0.1:3000;
              proxy_http_version 1.1;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
              proxy_read_timeout 200s;
          }
      }

  - path: ${app_dir}/.env
    permissions: '0600'
    content: |
      REGISTRY_ID=${registry_id}
      SITE_URL=https://${site_fqdn}
      # до выпуска сертификата сайт отвечает по http, и кука с secure не дошла бы до браузера
      SESSION_COOKIE_SECURE=0
      APP_ENV=prod
      MOCK_PAYMENTS=1

  - path: /etc/systemd/system/arcana.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Arcana Sense (docker compose)
      Requires=docker.service
      After=docker.service network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=${app_dir}
      ExecStart=/usr/bin/docker compose up -d --wait
      ExecStop=/usr/bin/docker compose down
      TimeoutStartSec=600

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/arcana-registry-login
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Вход в реестр по IAM-токену из метаданных: пароля на машине нет вовсе, права даёт
      # сервисный аккаунт, привязанный к VM.
      set -euo pipefail
      token="$(curl -sf -H 'Metadata-Flavor: Google' \
        'http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token' | jq -r .access_token)"
      echo "$token" | docker login --username iam --password-stdin cr.yandex

  - path: ${app_dir}/README
    permissions: '0644'
    content: |
      Что где на этой машине:
        ${app_dir}/docker-compose.yml   раскладка прода, её приносит release-prod.sh
        ${app_dir}/.env                 адрес сайта, реестр, секреты
        ${app_dir}/static/              _next/static, его отдаёт nginx с диска
        systemctl status arcana         состояние контейнеров
        docker compose logs -f          логи
      TLS: sudo certbot --nginx -d ${site_fqdn} -d www.${site_fqdn} --agree-tos -m ${admin_email} --redirect
      После выпуска сертификата поставить SESSION_COOKIE_SECURE=1 в .env и перезапустить службу.

  - path: /etc/cron.d/arcana-sweep
    permissions: "0644"
    content: |
      # Досверка платежей: уведомление могло не дойти, тогда исход подтянет опрос.
      # Задача в очереди создаётся только когда есть что опрашивать.
      */5 * * * * root cd ${app_dir} && /usr/bin/docker compose exec -T api python -m app.sweep >> /var/log/arcana-sweep.log 2>&1

runcmd:
  - [ bash, -c, "fallocate -l ${swap_size_mb}M /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile && echo '/swapfile none swap sw 0 0' >> /etc/fstab" ]
  - [ bash, -c, "mkdir -p ${app_dir}/static && chown -R ubuntu:ubuntu ${app_dir}" ]
  - [ bash, -c, "usermod -aG docker ubuntu" ]
  - [ bash, -c, "rm -f /etc/nginx/sites-enabled/default && ln -sfn /etc/nginx/sites-available/arcana.conf /etc/nginx/sites-enabled/arcana.conf && nginx -t && systemctl enable --now nginx && systemctl reload nginx" ]
  - [ bash, -c, "systemctl enable docker && systemctl start docker" ]
  - [ bash, -c, "/usr/local/bin/arcana-registry-login || true" ]
  - [ bash, -c, "systemctl daemon-reload && systemctl enable arcana" ]
