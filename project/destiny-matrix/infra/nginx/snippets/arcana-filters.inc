# Подключается в оба server-блока: правила защиты обязаны быть одинаковыми на проде и на тесте.
# Расхождение конфигов между контурами нам уже стоило дорого (браузер прода печатал страницу теста).

if ($arcana_scanner) { return 444; }
if ($arcana_no_agent) { return 444; }

# Пути, которых на сайте нет и быть не может: ни одного PHP-файла, никакого WordPress. Любой такой
# запрос — сканер, поэтому закрываем соединение молча, не тратя ни рендер, ни байты ответа.
location ~* (\.php$|\.aspx$|/wp-|/xmlrpc|/\.env|/\.git|/\.aws|/\.ssh|phpmyadmin|/vendor/|/administrator) {
    access_log off;
    return 444;
}
