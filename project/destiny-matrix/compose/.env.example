# Значения по умолчанию годятся для локального запуска; для прода обязательны JWT_SECRET и SITE_URL.
WEB_PORT=3000        # локально: node наружу
API_PORT=8010        # локально: api наружу, только для отладки

# адрес сайта: попадает в canonical, sitemap и OG на этапе сборки фронта
SITE_URL=http://127.0.0.1:3000

# по http кука сессии с флагом secure не ставится и вход не работает; на домене с TLS — 1
SESSION_COOKIE_SECURE=0

APP_ENV=dev
JWT_SECRET=dev-secret-меняется-в-проде-обязательно
MOCK_PAYMENTS=1

ADMIN_EMAILS=snborodaenko@mail.ru
ADMIN_PASSWORD=123

# Почта (Postbox). Пусто — письма не уходят, а пишутся в лог api.
# Логин и пароль — id и секрет api-ключа сервисного аккаунта arcana-mailer.
SMTP_USER=
SMTP_PASSWORD=

# Печать PDF. Браузер ходит на web по внутренней сети, готовые файлы уходят в бакет отчётов.
BROWSER_SECRET=dev-browser-secret
S3_REPORTS_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
