# Значения по умолчанию годятся для локального запуска; для прода обязательны JWT_SECRET и SITE_URL.
WEB_PORT=3000        # dev: node наружу
API_PORT=8010        # dev: api наружу, только для отладки
HTTP_PORT=8080       # --prod: единственный порт наружу, за ним nginx

# адрес сайта: попадает в canonical, sitemap и OG на этапе сборки фронта
SITE_URL=http://127.0.0.1:3000

# по http кука сессии с флагом secure не ставится и вход не работает; на домене с TLS — 1
SESSION_COOKIE_SECURE=0

# откуда браузер берёт _next/static: пусто — отдаёт nginx с диска; на проде сюда ставится
# бакет Object Storage или CDN поверх него. Значение вшивается на сборке фронта.
ASSET_PREFIX=

APP_ENV=dev
JWT_SECRET=dev-secret-меняется-в-проде-обязательно
MOCK_PAYMENTS=1

ADMIN_EMAILS=snborodaenko@mail.ru
ADMIN_PASSWORD=123
