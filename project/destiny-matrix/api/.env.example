APP_ENV=dev
# SQLite и в проде: нагрузка на одну виртуалку, WAL держит запись и чтение
DATABASE_URL=sqlite+pysqlite:///var/api.db
JWT_SECRET=dev-secret-change-me
JWT_TTL_DAYS=30
MOCK_PAYMENTS=1
# Один и тот же JSON передаётся API и web. COM не разрешает даже локальный mock.
SITE_PROFILES='[{"origin":"http://localhost:3000","defaultLocale":"ru","locales":["ru"],"payments":[{"id":"mock","provider":"mock","notificationUrl":"http://localhost:3000/api/payments/notify/mock"}]},{"origin":"http://127.0.0.1:3000","hosts":["127.0.0.1:3000","web:3000"],"defaultLocale":"en","locales":["en","ru"],"payments":[]}]'
# пусто: фронт ходит в API со своего сервера (BFF), кросс-доменных запросов нет.
# заполнять только под служебный клиент на другом домене
CORS_ORIGINS=
LOG_LEVEL=info

# админка: кто видит /api/admin/* и с каким паролем сид создаёт админа
ADMIN_EMAILS=snborodaenko@mail.ru
ADMIN_PASSWORD=123
